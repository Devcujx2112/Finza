<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window shown while the process starts, on Android 11 and below. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Applied once the process is up. This is the colour behind the Flutter
         UI, so it matches the launch background and there is nothing to flash
         between the two. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
