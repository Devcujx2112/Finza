<?xml version="1.0" encoding="utf-8"?>
<!-- Launch window for Android 11 and below. Android 12+ uses the
     SplashScreen API instead, configured in values-v31/styles.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item
        android:width="150dp"
        android:height="150dp"
        android:drawable="@drawable/launch_logo"
        android:gravity="center" />
</layer-list>
